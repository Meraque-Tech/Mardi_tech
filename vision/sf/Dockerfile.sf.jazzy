FROM ros:jazzy-ros-base-noble

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=jazzy \
    AGV_WS=/opt/agv_ws \
    DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket

# Keep the x86 sensor/fusion stack on Jazzy.  The x86 TensorRT container is
# based on Ubuntu 24.04 and Jazzy, and mixing its DDS participants with Humble
# participants in the same domain can make Humble deserialize Jazzy's global
# ROS graph messages with an incompatible schema (serdata.cpp errors).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bluez \
        build-essential \
        cmake \
        dbus \
        geographiclib-tools \
        libgeographiclib-dev \
        libomp-dev \
        libpcl-dev \
        nlohmann-json3-dev \
        python3-pip \
        python3-pymap3d \
        python3-serial \
        ros-dev-tools \
        ros-${ROS_DISTRO}-diagnostic-updater \
        ros-${ROS_DISTRO}-imu-tools \
        ros-${ROS_DISTRO}-pcl-conversions \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-visualization-msgs \
    && python3 -m pip install --no-cache-dir --break-system-packages 'bleak>=0.20' \
    && rm -rf /var/lib/apt/lists/*

WORKDIR ${AGV_WS}

COPY ./bwt901ble_imu src/bwt901ble_imu
COPY ./prime_msgs src/prime_msgs
COPY ./base_receiver src/base_receiver
COPY ./rtk_localization src/rtk_localization

RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build --merge-install --symlink-install

COPY ./amr_entrypoint.bash /amr_entrypoint.bash
RUN chmod 0755 /amr_entrypoint.bash

ENTRYPOINT ["/amr_entrypoint.bash"]
