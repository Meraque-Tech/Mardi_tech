# Jetson Orin Nano — JetPack 6.x, L4T r36.4.0 (CUDA/TensorRT preinstalled, no ROS)
# Built on top of Dockerfile.yolov8_trt_bed_detect_jetson_orien_nano.dep, which
# provides locale setup, ROS 2 Humble, and OpenCV/web server dependencies.
FROM meraquetech/race_nav:yolov8-trt-bed-detect-orin-nano.dep

SHELL ["/bin/bash", "-c"]

WORKDIR /ros2_ws/src
# yolov8_trt_bed_detect_orin is a fork of yolov8_trt_bed_detect (the Jetson
# Nano package) ported to TensorRT 10 (bundled with this image's JetPack 6 /
# L4T r36.4.0) and CUDA arch sm_87 (Orin's Ampere GPU, vs. the Nano's
# Maxwell sm_53) -- the original package's TensorRT-8-era API calls and CUDA
# arch don't work on this image. See yolov8_trt_bed_detect_orin/ for details.
COPY yolov8_trt_bed_detect_orin/ yolov8_trt_bed_detect_orin/

WORKDIR /ros2_ws
RUN ROS_SETUP=$(find /opt/ros /root -name "setup.bash" 2>/dev/null | head -1) && \
    echo "Using: $ROS_SETUP" && \
    source "$ROS_SETUP" && \
    colcon build --packages-select yolov8_trt_bed_detect_orin \
    --cmake-args -DCMAKE_BUILD_TYPE=Release


