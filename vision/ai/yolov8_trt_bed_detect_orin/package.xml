  <version>0.0.0</version>
  <description>YOLOv8 TensorRT bed detection node with webcam input</description>
  <maintainer email="debanik@solarisrobots.in">Debanik</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

