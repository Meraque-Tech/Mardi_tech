# Jetson Nano — JetPack 4.6.1, CUDA 10.2, TensorRT 8.2.1
# FROM nvcr.io/nvidia/l4t-tensorrt:r8.2.1-runtime
FROM dustynv/ros:humble-pytorch-l4t-r32.7.1

ENV DEBIAN_FRONTEND=noninteractive
ENV OPENBLAS_CORETYPE=ARMV8
# ENV CUDA_HOME=/usr/local/cuda
# ENV CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda
# Select bash as default shell
SHELL ["/bin/bash", "-c"]


# Add JetPack 4.6.x apt repo (Jetson Nano = Tegra210/t210, L4T r32.7)
RUN echo "deb https://repo.download.nvidia.com/jetson/common r32.7 main" \
        > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    echo "deb https://repo.download.nvidia.com/jetson/t210 r32.7 main" \
        >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    wget -qO - https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
        | apt-key add -

# RUN echo "/usr/local/cuda/lib64" > /etc/ld.so.conf.d/cuda.conf && ldconfig

RUN rm -f /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y \
    tensorrt \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/lib/aarch64-linux-gnu/tegra/libv4l2.so.0 /usr/lib/aarch64-linux-gnu/libv4l2.so

# check tensorRT installation
RUN dpkg -l | grep tensorrt
# check CUDA installation
RUN nvcc --version  
#  check OpenCV installation
RUN pkg-config --modversion opencv4
# check NVInfer header files
RUN ls /usr/include/aarch64-linux-gnu/ | grep NvInfer   \
    && ls /usr/include/aarch64-linux-gnu/ | grep NvInferRuntime

# Find and print where ROS is installed in this image
RUN find /opt/ros /root -name "setup.bash" 2>/dev/null || echo "WARNING: setup.bash not found"

# Build the ROS 2 package
WORKDIR /ros2_ws/src
COPY yolov8_trt_target_detect/ yolov8_trt_target_detect/

WORKDIR /ros2_ws
RUN ROS_SETUP=$(find /opt/ros /root -name "setup.bash" 2>/dev/null | head -1) && \
    echo "Using: $ROS_SETUP" && \
    source "$ROS_SETUP" && \
    colcon build --packages-select yolov8_trt_target_detect \
    --cmake-args -DCMAKE_BUILD_TYPE=Release

ENV ROS_SETUP_CMD="source \$(find /opt/ros /root -name setup.bash 2>/dev/null | head -1)"

# Usage:
#   docker run ... ros2 run yolov8_trt_target_detect yolov8_trt_target_detect -d weights/best.engine ./ g -conf 0.85
CMD ["/bin/bash", "-c", \
    "source $(find /opt/ros /root -name setup.bash 2>/dev/null | head -1) && \
     source /ros2_ws/install/setup.bash && bash"]
